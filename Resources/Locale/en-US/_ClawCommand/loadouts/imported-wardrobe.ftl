# Claw Command - names for the imported wardrobe loadout groups.
#
# Only fallback groups need a name here. Everything else imported was folded into the group each
# job already had for that slot, so it inherits that group's existing name.

cc-loadout-group-wardrobe-hats = Wardrobe: headwear
cc-loadout-group-wardrobe-neckwear = Wardrobe: neckwear and capes
cc-loadout-group-wardrobe-outfits = Wardrobe: outfits
cc-loadout-group-wardrobe-footwear = Wardrobe: footwear
cc-loadout-group-wardrobe-accessories = Wardrobe: accessories

# The warden was the only head-of-staff role without a neck group; this matches the naming the
# captain, HoP, HoS, CE, CMO, RD and QM ones already use.
loadout-group-warden-neck = Warden neck
